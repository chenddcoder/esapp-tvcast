# 发版部署配置（不要提交真实值；复制为 .deploy.env 后填）
SERVER_BASE=https://www.chenddcoder.cn
PACKAGE_NAME=cn.chenddcoder.tvcast
APP_NAME=投屏显象
ICON_URL=https://www.chenddcoder.cn/upload/tvcast-icon.svg
CIRCLE_LOGO_URL=https://www.chenddcoder.cn/upload/tvcast-icon.svg

# 鉴权（二选一，推荐账号密码方式：脚本自动登录拿新 token，避免 JWT 过期）
# 方式一：直接放 admin JWT
DEPLOY_TOKEN=
# 方式二：账号密码（.deploy.env 中填写）
DEPLOY_USER=admin
DEPLOY_PASS=
